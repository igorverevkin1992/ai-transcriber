# =============================================================================
# ABTGS — переменные окружения
# Скопируйте этот файл в .env и заполните нужные значения.
# =============================================================================

# --- Speech recognition ---

# Yandex SpeechKit API key (опционально, только для облачного движка с диаризацией)
YANDEX_API_KEY=your_yandex_api_key_here

# HuggingFace token для скачивания pyannote-моделей диаризации.
# Получить: https://huggingface.co/settings/tokens
# Без HF_TOKEN WhisperX работает БЕЗ диаризации (все сегменты = speaker 0).
HF_TOKEN=your_hf_token_here

# Точное число говорящих для подсказки pyannote, когда оно известно, а имён в
# имени файла нет (без хинта короткие реплики ведущего сливаются с гостем).
# Приоритет: токен `sN` в имени файла (напр. 17.06.2026_s3_f15.wmv) → этот env →
# число имён из имени файла. 0 = не задано.
# DIARIZATION_NUM_SPEAKERS=0

# Резегментация по словам. whisperx размечает спикера КАЖДОМУ слову, но один
# ASR-сегмент часто захватывает короткую вставку другого спикера (вопрос
# ведущего внутри монолога гостя). true — режем сегмент на однородные по
# спикеру куски по word-level меткам; сегменты без смены спикера внутри не
# трогаются (текст сохраняется дословно). default: true. false — прежнее
# поведение (один спикер на весь ASR-сегмент).
# WORD_LEVEL_DIARIZATION=true

# --- LLM post-processing ---

# Gemini API ключ для полировки текста (убирает паразиты, ставит пунктуацию).
# Получить: https://aistudio.google.com/apikey
# Без GEMINI_API_KEY применяется только regex-чистка.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication ---

# Если задан — все /api/* запросы требуют заголовок X-API-Key.
# Не задавайте локально (auth отключится), задавайте для internet-facing deployment.
# API_KEY=your_secret_api_key_here
# VITE_API_KEY=your_secret_api_key_here  # frontend (должен совпадать с API_KEY)

# --- CORS ---

# Разрешённые origins (через запятую). НЕ используйте "*" в проде.
CORS_ORIGINS=http://localhost:3000

# --- Transcript formatting (структура как в эталонных стенограммах) ---

# Склейка последовательных реплик одного спикера в один абзац
# с инлайн-таймкодами. false — legacy-режим (один ASR-сегмент = один абзац).
# TURN_MERGE_ENABLED=true

# Интервал инлайн-таймкодов внутри длинной реплики, секунды (default: 60)
# TURN_INLINE_TC_SECONDS=60

# Пауза в записи, при которой вставляется "(Технические моменты)." (default: 30)
# TECH_BREAK_GAP_SECONDS=30

# Точка после маркера техпаузы: "(Технические моменты)." (true) или без точки
# "(Технические моменты)" (false). default: true (как в эталонах f7/f8).
# TECH_BREAK_DOT=true

# Резать сегмент по смене спикера ТОЛЬКО на конце предложения. pyannote часто
# ошибочно метит хвост фразы героя соседним спикером посреди предложения
# («…кто [там попался]»); раньше этот хвост приклеивался к началу реплики
# ведущего. При true флип посреди фразы игнорируется, реальные вставки ведущего
# (после точки) режутся как прежде. default: true. Требует WORD_LEVEL_DIARIZATION.
# WORD_SPLIT_SENTENCE_BOUNDARY=true

# Свернуть реплики неназванного «лишнего» спикера в «(Технические моменты)».
# Диаризация нередко выделяет члена съёмочной группы отдельным кластером
# («Спикер N» — не интервьюер и не названный гость). Его реплики (команды
# оператору, «в моторе», «допишем») в эталонах помечены техмоментом. При true
# реплики генерик-спикера с долей речи <= MAX_RATIO заменяются маркером, а сам
# спикер убирается из легенды. default: false (риск задеть редкого гостя).
# UNNAMED_SPEAKER_AS_TECH=false
# UNNAMED_SPEAKER_TECH_MAX_RATIO=0.15

# --- Whisper tuning ---

# beam_size: выше = точнее, но медленнее. Рекомендуется 5-10 (default: 5)
# WHISPER_BEAM_SIZE=5

# Подсказка декодеру Whisper (контекст/жанр). Имена спикеров из имени файла
# добавляются автоматически.
# WHISPER_INITIAL_PROMPT=Интервью на русском языке.

# --- ASR anti-hallucination ---

# Фразы-галлюцинации Whisper (через запятую). Задание env ЗАМЕНЯЕТ встроенный
# список («субтитры», «продолжение следует», «спасибо за просмотр» и др.)
# HALLUCINATION_BLACKLIST=субтитры,продолжение следует

# Порог avg_logprob: ниже — сегмент заменяется на "(неразборчиво)" (default: -1.2)
# UNCLEAR_LOGPROB_THRESHOLD=-1.2

# Порог no_speech_prob: выше — сегмент отбрасывается как не-речь (default: 0.85)
# NO_SPEECH_PROB_THRESHOLD=0.85

# --- SpeechKit tuning ---

# literature_text=True оптимизирует вывод для письменного текста (числа прописью).
# Для разговорной речи (интервью) рекомендуется false (default: false).
# SPEECHKIT_LITERATURE_TEXT=false

# Авто-определение имён гостей: если в имени файла нет имён, имя-отчество гостя
# берётся из того, как к нему обращаются в диалоге («Олег Александрович, …»),
# и заменяет «Спикер N». Gemini при наличии GEMINI_API_KEY, иначе эвристика.
# Интервьюер остаётся АЗК. default: true.
# SPEAKER_NAME_AUTODETECT=true

# --- Gemini tuning ---

# Модель Gemini для полировки текста (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Более сильная модель для «умных» пассов (правка границ спикеров, техмоменты,
# имена, паспорт). Полировка остаётся на GEMINI_MODEL. Пусто → GEMINI_MODEL.
# ВАЖНО: ID должен существовать для вашего ключа. При 404 пассы автоматически
# откатываются на GEMINI_MODEL, а лог старта печатает список доступных моделей —
# выберите pro-ID из него.
# GEMINI_MODEL_SMART=

# Проверка доступности Gemini при старте сервера (тестовый вызов): сбой
# ключа/прокси виден в логе сразу, а не как молчаливое отсутствие техмоментов.
# GEMINI_HEALTHCHECK=true

# Gemini-правка границ спикеров: диаризация изредка относит короткую реплику
# ЦЕЛИКОМ не тому говорящему (ответ гостя в абзаце ведущего и наоборот). Отдельный
# проход читает диалог + контекст (роли/имена из «паспорта съёмки», тема) и
# переназначает ТОЛЬКО уверенно перепутанные реплики. default: false (opt-in,
# вероятностная правка; требует GEMINI_API_KEY).
# SPEAKER_BOUNDARY_CORRECTION=false

# OCR выжженного в кадр таймкода. Если стартовый ТК не задан ни в имени файла,
# ни в метаданных — распознать таймкод прямо с картинки (easyocr) и считать ТК
# первого кадра. Приоритет: имя файла → метаданные → OCR → 00:00:00. default: true.
# OCR_TIMECODE=true
# Область кадра с таймкодом, доли 0-1: left,top,right,bottom. default — ВСЯ
# нижняя треть кадра (бокс ТК бывает и по центру снизу, и справа). Пусто →
# искать по всему кадру.
# OCR_TIMECODE_REGION=0.0,0.65,1.0,1.0

# Консервативное определение «технических моментов» (реплики съёмочной группы,
# перезапуски камеры, проверка микрофона) через Gemini → заменяются маркером
# «(Технические моменты).». Требует GEMINI_API_KEY. При сомнении фрагмент
# остаётся в тексте. default: true. Отключить — false.
# TECH_MOMENT_DETECTION=true

# Агрессивный режим техмоментов: помимо техники помечает и закадровую
# организационную болтовню (обращения к посторонним по имени, «пойду умоюсь»,
# «давай с тебя»). default: false (риск задеть реальные реплики). Требует
# GEMINI_API_KEY.
# TECH_MOMENT_AGGRESSIVE=false

# --- DOCX formatting ---

# Тире в легенде между именем и аббревиатурой: en-dash "–" (default, f7/f8) или
# em-dash "—". Для совпадения с эталонами с em-dash: LEGEND_DASH=—
# LEGEND_DASH=–
# Точка в конце строки легенды/разделителя. default: true (f7/f8).
# LEGEND_TRAILING_DOT=true
# Внутренние разделители-легенды перед первой репликой каждого гостя (при >1
# госте). default: true. false — единый блок легенды сверху, без повторов.
# SECTION_DIVIDERS_ENABLED=true

# Двухбуквенные аббревиатуры для двухсловных имён без отчества: «Арнальди
# Федерико» → «АФ» (эталон ф13). default: false — одна буква («Майданов
# Денис» → «М», эталоны f7/f8). Имя-отчество всегда даёт инициалы (ОА/ГВ).
# ABBR_TWO_LETTER=false

# --- Performance tuning ---

# Параллельные задачи транскрипции. На GPU авто-определяется по VRAM (1 на 8 ГБ).
# Раскомментируйте чтобы переопределить.
# MAX_CONCURRENT_TASKS=2

# Retry failed tasks (default: 3)
# MAX_RETRIES=3

# Threshold для warning о низкой RAM (default: 500 MB)
# MIN_RAM_MB=500

# --- Storage ---

# Путь к SQLite базе (default: projects.db в рабочей директории)
# В Docker должно указывать на mounted volume.
# SQLITE_DB_PATH=/app/data/projects.db
