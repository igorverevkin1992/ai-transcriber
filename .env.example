# =============================================================================
# ABTGS — переменные окружения
# Скопируйте этот файл в .env и заполните нужные значения.
# =============================================================================

# --- Speech recognition ---

# Yandex SpeechKit API key (опционально, только для облачного движка с диаризацией)
YANDEX_API_KEY=your_yandex_api_key_here

# HuggingFace token для скачивания pyannote-моделей диаризации.
# Получить: https://huggingface.co/settings/tokens
# Без HF_TOKEN WhisperX работает БЕЗ диаризации (все сегменты = speaker 0).
HF_TOKEN=your_hf_token_here

# --- LLM post-processing ---

# Gemini API ключ для полировки текста (убирает паразиты, ставит пунктуацию).
# Получить: https://aistudio.google.com/apikey
# Без GEMINI_API_KEY применяется только regex-чистка.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication ---

# Если задан — все /api/* запросы требуют заголовок X-API-Key.
# Не задавайте локально (auth отключится), задавайте для internet-facing deployment.
# API_KEY=your_secret_api_key_here
# VITE_API_KEY=your_secret_api_key_here  # frontend (должен совпадать с API_KEY)

# --- CORS ---

# Разрешённые origins (через запятую). НЕ используйте "*" в проде.
CORS_ORIGINS=http://localhost:3000

# --- Transcript formatting (структура как в эталонных стенограммах) ---

# Склейка последовательных реплик одного спикера в один абзац
# с инлайн-таймкодами. false — legacy-режим (один ASR-сегмент = один абзац).
# TURN_MERGE_ENABLED=true

# Интервал инлайн-таймкодов внутри длинной реплики, секунды (default: 60)
# TURN_INLINE_TC_SECONDS=60

# Пауза в записи, при которой вставляется "(Технические моменты)." (default: 30)
# TECH_BREAK_GAP_SECONDS=30

# --- Whisper tuning ---

# beam_size: выше = точнее, но медленнее. Рекомендуется 5-10 (default: 5)
# WHISPER_BEAM_SIZE=5

# Подсказка декодеру Whisper (контекст/жанр). Имена спикеров из имени файла
# добавляются автоматически.
# WHISPER_INITIAL_PROMPT=Интервью на русском языке.

# --- ASR anti-hallucination ---

# Фразы-галлюцинации Whisper (через запятую). Задание env ЗАМЕНЯЕТ встроенный
# список («субтитры», «продолжение следует», «спасибо за просмотр» и др.)
# HALLUCINATION_BLACKLIST=субтитры,продолжение следует

# Порог avg_logprob: ниже — сегмент заменяется на "(неразборчиво)" (default: -1.2)
# UNCLEAR_LOGPROB_THRESHOLD=-1.2

# Порог no_speech_prob: выше — сегмент отбрасывается как не-речь (default: 0.85)
# NO_SPEECH_PROB_THRESHOLD=0.85

# --- SpeechKit tuning ---

# literature_text=True оптимизирует вывод для письменного текста (числа прописью).
# Для разговорной речи (интервью) рекомендуется false (default: false).
# SPEECHKIT_LITERATURE_TEXT=false

# --- Gemini tuning ---

# Модель Gemini для полировки текста (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# --- Performance tuning ---

# Параллельные задачи транскрипции. На GPU авто-определяется по VRAM (1 на 8 ГБ).
# Раскомментируйте чтобы переопределить.
# MAX_CONCURRENT_TASKS=2

# Retry failed tasks (default: 3)
# MAX_RETRIES=3

# Threshold для warning о низкой RAM (default: 500 MB)
# MIN_RAM_MB=500

# --- Storage ---

# Путь к SQLite базе (default: projects.db в рабочей директории)
# В Docker должно указывать на mounted volume.
# SQLITE_DB_PATH=/app/data/projects.db
