# =============================================================================
# ABTGS — переменные окружения
# Скопируйте этот файл в .env и заполните нужные значения.
# =============================================================================

# --- Speech recognition ---

# Yandex SpeechKit API key (опционально, только для облачного движка с диаризацией)
YANDEX_API_KEY=your_yandex_api_key_here

# HuggingFace token для скачивания pyannote-моделей диаризации.
# Получить: https://huggingface.co/settings/tokens
# Без HF_TOKEN WhisperX работает БЕЗ диаризации (все сегменты = speaker 0).
HF_TOKEN=your_hf_token_here

# --- LLM post-processing ---

# Gemini API ключ для полировки текста (убирает паразиты, ставит пунктуацию).
# Получить: https://aistudio.google.com/apikey
# Без GEMINI_API_KEY применяется только regex-чистка.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication ---

# Если задан — все /api/* запросы требуют заголовок X-API-Key.
# Не задавайте локально (auth отключится), задавайте для internet-facing deployment.
# API_KEY=your_secret_api_key_here
# VITE_API_KEY=your_secret_api_key_here  # frontend (должен совпадать с API_KEY)

# --- CORS ---

# Разрешённые origins (через запятую). НЕ используйте "*" в проде.
CORS_ORIGINS=http://localhost:3000

# --- Performance tuning ---

# Параллельные задачи транскрипции. На GPU авто-определяется по VRAM (1 на 8 ГБ).
# Раскомментируйте чтобы переопределить.
# MAX_CONCURRENT_TASKS=2

# Retry failed tasks (default: 3)
# MAX_RETRIES=3

# Threshold для warning о низкой RAM (default: 500 MB)
# MIN_RAM_MB=500

# --- Storage ---

# Путь к SQLite базе (default: projects.db в рабочей директории)
# В Docker должно указывать на mounted volume.
# SQLITE_DB_PATH=/app/data/projects.db
