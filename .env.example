# Yandex SpeechKit API key (required for cloud speech recognition with diarization)
YANDEX_API_KEY=your_yandex_api_key_here

# API key for authenticating /api/* requests. If not set, auth is disabled (local dev).
# Set this for any internet-facing deployment.
# API_KEY=your_secret_api_key_here
# Frontend must have matching key:
# VITE_API_KEY=your_secret_api_key_here

# CORS origins (comma-separated, for development)
# CORS_ORIGINS=http://localhost:3000
